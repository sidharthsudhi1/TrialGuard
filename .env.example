# Copy this to .env and fill in values. Never commit .env.

# --- LLM inference ---
GROQ_API_KEY=
# LLM_PROVIDER=deepinfra   # default since Phase 8; set groq to reproduce Phase 3/4
DEEPINFRA_API_KEY=
DAILY_USD_CAP=2.00

# --- Tracing (Langfuse free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# SDK v3 reads LANGFUSE_BASE_URL; LANGFUSE_HOST is the pydantic-settings alias
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Vector store (pgvector — Neon paid for 26k corpus) ---
DATABASE_URL=postgresql://user:password@host:5432/trialguard

# --- Demo ---
# TG_DEMO_SOURCE=sigir       # $0 FileIndex (HF Spaces default)
# TG_DEMO_SOURCE=ctgov_live  # production corpus (needs DATABASE_URL)
# TG_PROMPT_VERSION=v4       # inclusion + exclusion (app.py defaults to v4)

# --- Stage A API (FastAPI + Next.js) ---
# API_CORS_ORIGIN=http://localhost:3000   # single origin — never *
# API_MAX_ASSESS_TRIALS=5
# API_SEARCH_RATE_PER_MIN=10
# API_ASSESS_RATE_PER_MIN=5
# API_JOB_TTL_SECONDS=3600
# API_ASSESS_WORKERS=2

# --- Condition scope ---
CONDITION_CLASS=oncology

# --- ClinicalTrials.gov API (no auth needed — left for reference) ---
CTGOV_API_BASE=https://clinicaltrials.gov/api/v2

# --- Hugging Face (for HF Spaces deploy) ---
HF_TOKEN=
