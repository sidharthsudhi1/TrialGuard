# Stage A FastAPI — Fly.io (or any Docker host with ≥2 GB RAM for MedCPT).

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
# Preset notes are read from this fixture to decide the analyst cache-write policy
# (WS-4). Small and tracked; without it every note is treated as free text.
COPY data/eval/sigir/queries.jsonl ./data/eval/sigir/queries.jsonl

# CPU-only torch, installed first so the project resolve sees it satisfied. The
# default linux wheel bundles ~2 GB of NVIDIA CUDA libraries; this machine has no
# GPU, so none of it ever executes, but every byte still has to page in from the
# image at boot. That is why startup took ~114s on shared and performance CPUs
# alike: the cost was I/O, not compute.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -e ".[web]"

# Bake MedCPT into the image. Without this, the first request after every cold
# boot downloads ~440 MB from HuggingFace inside the FastAPI lifespan hook, which
# outlasts the health-check grace period: the machine never answers, Fly marks it
# critical and restarts it, and it never escapes the loop.
#
# BOTH encoders. MedCPT is a dual encoder and these are two separate models:
# serving only ever embeds queries, so baking the query side alone looked
# complete and was, for the API. The scheduled refresh embeds trial *documents*,
# so it needed the article encoder that was never baked -- and HF_HUB_OFFLINE
# below then made fetching it impossible. Its first run died on
# "We couldn't connect to 'https://huggingface.co'", which would have repeated
# every night that CT.gov had a new or revised trial, which is most nights.
ENV TG_EMBED_BACKEND=medcpt
RUN python -c "from trialguard.ingestion.embed import embed_batch, embed_text; \
    embed_text('warmup', is_query=True); \
    embed_batch(['warmup'], is_query=False)"

# Set after the bake, which needs the network. From here every weight is local,
# so a Hub round trip on each from_pretrained is pure boot latency — and if a
# model were ever missing, failing loudly beats silently pulling 440 MB during
# the health-check grace period.
ENV HF_HUB_OFFLINE=1

# Assert the invariant the line above creates, rather than assume it. The bake
# proves a model can be downloaded; this proves it is present with the network
# gone, which is the condition the container actually runs under. It fails the
# build instead of the 3am refresh, and it is the check the article encoder
# needed and did not have.
RUN python -c "from trialguard.ingestion.embed import embed_batch, embed_text; \
    embed_text('offline check', is_query=True); \
    embed_batch(['offline check'], is_query=False)"

ENV TG_PROMPT_VERSION=v4
ENV TG_ANALYST_DELAY=0
ENV PORT=8000

EXPOSE 8000

CMD ["sh", "-c", "uvicorn trialguard.api.app:app --host 0.0.0.0 --port ${PORT}"]
